# All time intervals are either integer seconds or strings conforming to the
# requirements of the constructor of the Pandas Timedelta type.

[paths]
# Public, client-visible SQLite snapshots. The ingester publishes here only by
# hidden-copy + atomic rename and does not mutate these SQLite files directly.
data-directory = "/big/mcast/data/feder"

# Durable local ingester storage for mutable SQLite databases. Must survive
# ingester restarts. Must be distinct from and not nested inside data/scratch.
staging-directory = "/local/durable/feder-staging"

# Ephemeral scratch storage. The ingester uses scratch/ingester-export for
# temporary clean snapshots; scratch may be cleared between restarts.
scratch-directory = "/big/mcast/data/feder-scratch"

# Required for live RabbitMQ receiver/ingester modes. Omit in finite
# file-only workflows that use receiver file output and ingester file input.
[rabbitmq]
host = "g01"
port = 5672
username = "feder"
password = "dflksjdflkjsd"

# Required only by state-of-feder email reporting; rx/ingest do not need it.
[mailjet]
api_key = "<fill in API key>"
secret_key = "<fill in secret key>"
from_email = "state-of-feder@mit.edu"
from_name = "State of Feder"
to_email = "state-of-feder@mit.edu"
to_name = "State of Feder"

[ingester]
# Required for live RabbitMQ ingester mode. File-input ingester mode may omit
# prometheus-port and will not start a Prometheus server by default.
prometheus-port = 19001
export-interval = "1 hour"
finalize-after = "12 hours"

[sources]
# Defaults for all sources.
completion-delay = "15 minutes"
completion-interval = 60
data-lag = 0

[source.contrails-api]
data-lag = "48 hours"
api-key = "<fill in API key>"
bounds = [-140.0, -45.0, 5.0, 65.0]  # [min_lon, max_lon, min_lat, max_lat]
prometheus-port = 19002

[source.flightaware]
username = "<fill in username>"
password = "<fill in password>"
prometheus-port = 19003

[source.opensky]
api-key = "<fill in API key>"
prometheus-port = 19004

[source.opensky-state-vectors]
api-key = "<fill in API key>"
prometheus-port = 19005
