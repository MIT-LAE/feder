[Unit]
Description=Feder Contrails API receiver
After=network-online.target

[Service]
Environment=FEDER_CONFIG=/home/mcast/misc-config/feder-config.toml
Restart=on-failure
ExecStart=/home/mcast/.local/bin/uv --directory /home/mcast/code/feder \
  run feder-rx contrails-api

[Install]
WantedBy=multi-user.target
