#!/usr/bin/env bash
# Install from cron daily, e.g.:
# 15 2 * * * /path/to/submit-feder-ingest-ready-queue
# The squeue check avoids needless submissions; Slurm's singleton dependency
# is the concurrency guarantee and does not use shared-filesystem locks.
set -euo pipefail

JOB_NAME="feder-ingest-ready-queue"
SBATCH_TEMPLATE="REPLACE_WITH_DEPLOY_DIRECTORY/feder-ingest-ready-queue.sbatch.template"

if squeue --noheader --name="${JOB_NAME}" --user="${USER}" | grep -q .; then
    echo "${JOB_NAME} is already queued or running; not submitting" >&2
    exit 0
fi

exec sbatch --dependency=singleton --job-name="${JOB_NAME}" "${SBATCH_TEMPLATE}"
