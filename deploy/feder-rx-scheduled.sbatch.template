#!/usr/bin/env bash
#SBATCH --job-name=feder-rx-scheduled
#SBATCH --account=REPLACE_WITH_ACCOUNT
#SBATCH --partition=REPLACE_WITH_PARTITION
#SBATCH --time=REPLACE_WITH_TIME_LIMIT
#SBATCH --output=REPLACE_WITH_LOG_DIRECTORY/feder-rx-scheduled-%j.out
#SBATCH --mail-type=FAIL
#SBATCH --mail-user=REPLACE_WITH_FAILURE_EMAIL

# Replace every REPLACE_WITH_* value for this site.  Slurm directives are read
# before the shell runs, so keep account, partition, time, and log paths here.
set -euo pipefail

FEDER_REPOSITORY="REPLACE_WITH_FEDER_REPOSITORY"
FEDER_CONFIG="REPLACE_WITH_CONFIG_PATH"
# Load the site's modules or activate its environment here, for example:
# module load python/3.13
# source /path/to/venv/bin/activate

args=(--config "${FEDER_CONFIG}")
# Set this only for the one-time cursor bootstrap.  Leave empty thereafter.
INITIAL_START_TIME=""
if [[ -n "${INITIAL_START_TIME}" ]]; then
    args+=(--initial-start-time "${INITIAL_START_TIME}")
fi

# One invocation retrieves at most receiver.max-run-duration (24 hours by
# default).  It is safe for this receiver and the ingester job to overlap:
# they use independent Slurm singleton names and atomic ready-directory moves.
uv --directory "${FEDER_REPOSITORY}" run feder-rx-scheduled \
    "${args[@]}" contrails-api
